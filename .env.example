MUSIC_SOURCE_BASE_URL=https://your-private-music-api.example.com
ACCOUNT_SERVICE_BASE_URL=http://127.0.0.1:3002
MUSIC_SOURCE_API_KEY=
MUSIC_SOURCE_TIMEOUT_MS=6000
MUSIC_SOURCE_RETRY_TIMES=1
# Enable only after verifying the ncm-api netease-api-v2 egress guard.
MUSIC_SOURCE_EGRESS_MANAGED=0
# Trust X-Real-IP only behind overwriting Nginx with both services on loopback.
ACCOUNT_TRUST_PROXY_HEADERS=0
# Unmanaged fallback: all music JSON requests share this conservative queue.
# Managed deployment uses max concurrent 8 and no duplicate BFF interval.
MUSIC_SOURCE_MAX_CONCURRENT=2
MUSIC_SOURCE_MIN_INTERVAL_MS=1000
MUSIC_SOURCE_MAX_QUEUE=64
MUSIC_SOURCE_QUEUE_TIMEOUT_MS=30000
MUSIC_SOURCE_PLAY_LEVEL=standard
MUSIC_SOURCE_VIP_PREVIEW_MAX_MS=60000
MUSIC_SOURCE_PATH_PLAY_URL_UNBLOCK=/song/url/match
MUSIC_SOURCE_UNBLOCK_SOURCE=
MUSIC_SOURCE_UNBLOCK_SOURCES=unm,msls,qijieya
MUSIC_SOURCE_MOCK_ENABLED=false
MUSIC_SOURCE_MOCK_FALLBACK=false
MUSIC_SOURCE_PATH_SEARCH=/search
MUSIC_SOURCE_PATH_TRACK_DETAIL=/song/detail
MUSIC_SOURCE_PATH_PLAY_URL=/song/url/v1
MUSIC_SOURCE_PATH_LYRIC=/lyric
MUSIC_SOURCE_PATH_LYRIC_NEW=/lyric/new
MUSIC_SOURCE_PATH_PLAYLIST=/playlist/detail
MUSIC_SOURCE_ENABLE_DISCOVER=true
MUSIC_SOURCE_ENABLE_SCENE=true
MUSIC_SOURCE_DOWNLOAD_LEVEL=exhigh
MUSIC_SOURCE_LYRIC_PREFER_NEW=true
# Optional public frontend settings (defaults match the original 唱片行 frontend)
# NEXT_PUBLIC_SITE_NAME=唱片行
# NEXT_PUBLIC_BRAND_BIG=Mining
# NEXT_PUBLIC_BRAND_SMALL=唱片行
# NEXT_PUBLIC_DEFAULT_QUALITY=exhigh
# NEXT_PUBLIC_REPLACE_TOPLIST_COVERS=on
# NEXT_PUBLIC_IMAGE_RESIZE=on
MUSIC_SOURCE_PATH_SEARCH_HOT_DETAIL=/search/hot/detail
MUSIC_SOURCE_PATH_SEARCH_DEFAULT=/search/default
MUSIC_SOURCE_PATH_SEARCH_SUGGEST_PC=/search/suggest/pc
MUSIC_SOURCE_PATH_BANNER=/banner
MUSIC_SOURCE_PATH_PERSONALIZED=/personalized
MUSIC_SOURCE_PATH_TOPLIST_DETAIL=/toplist/detail
MUSIC_SOURCE_PATH_TOP_PLAYLIST_HIGHQUALITY=/top/playlist/highquality
MUSIC_SOURCE_PATH_TOPLIST=/toplist
MUSIC_SOURCE_PATH_ALBUM=/album
MUSIC_SOURCE_PATH_ALBUM_DETAIL=/album/detail
MUSIC_SOURCE_PATH_ARTIST_DETAIL=/artist/detail
MUSIC_SOURCE_PATH_ARTIST_TOP_SONG=/artist/top/song
MUSIC_SOURCE_PATH_CHECK_MUSIC=/check/music
MUSIC_SOURCE_PATH_SONG_CREATORS=/song/creators
MUSIC_SOURCE_PATH_SONG_WIKI_SUMMARY=/song/wiki/summary
MUSIC_SOURCE_PATH_SONG_CHORUS=/song/chorus
MUSIC_SOURCE_PATH_SONG_COPYRIGHT_RCMD=/song/copyright/rcmd
MUSIC_SOURCE_PATH_SONG_DOWNLOAD_URL=/song/download/url/v1
MUSIC_SOURCE_PATH_SATI_TAG_LIST=/sati/tag/list
MUSIC_SOURCE_PATH_SATI_RESOURCE_LIST=/sati/resource/list
MUSIC_SOURCE_PATH_RADIO_SPORT_GET=/radio/sport/get
